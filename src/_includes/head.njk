<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ pageTitle or site.seo_titolo }}</title>
<meta name="description" content="{{ pageDescription or site.seo_descrizione }}">
{% if not build.index %}<meta name="robots" content="noindex, nofollow">{% endif %}
<link rel="canonical" href="{{ site.dominio }}{{ page.url | replace('index.html','') }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:title" content="{{ ogTitle or (site.nome + ', ' + site.professione) }}">
<meta property="og:description" content="{{ pageDescription or site.seo_descrizione }}">
<meta property="og:url" content="{{ site.dominio }}{{ page.url | replace('index.html','') }}">
<meta property="og:image" content="{{ site.dominio }}{{ ogImage or '/share.jpg' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<meta name="theme-color" content="#f7f1e8">
<link rel="preload" href="/assets/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/instrument-sans-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
